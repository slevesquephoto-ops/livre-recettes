# ====== VidéoRecettes — Configuration ======
# Copier ce fichier vers `.env` puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être versionné dans git.

# Base de données SQLite (fichier local, rien à installer)
DATABASE_URL="file:./dev.db"

# Fournisseur d'IA pour la structuration : "gemini" ou "ollama"
LLM_PROVIDER="gemini"

# --- Gemini (gratuit) : clé obtenue sur aistudio.google.com ---
GEMINI_API_KEY="votre-clé-gemini-ici"
GEMINI_MODEL="gemini-2.0-flash"

# --- Ollama (option locale, si LLM_PROVIDER="ollama") ---
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# --- Transcription locale (Phase 2) ---
# Windows :
PYTHON_BIN="C:\\Users\\TON_NOM\\.venv-recettes\\Scripts\\python.exe"
YTDLP_BIN="C:\\Users\\TON_NOM\\.venv-recettes\\Scripts\\yt-dlp.exe"
# Linux/Mac :
# PYTHON_BIN="/home/TON_NOM/.venv-recettes/bin/python"
# YTDLP_BIN="/home/TON_NOM/.venv-recettes/bin/yt-dlp"
WHISPER_MODEL="small"
WHISPER_DEVICE="cpu"   # "cuda" si une carte NVIDIA avec CUDA est disponible

# --- Facebook (Phase 2, jalon 2.2) ---
# Windows :
FB_COOKIES_PATH="C:\\Users\\TON_NOM\\cookies-facebook.txt"
# Linux/Mac :
# FB_COOKIES_PATH="/home/TON_NOM/cookies-facebook.txt"
